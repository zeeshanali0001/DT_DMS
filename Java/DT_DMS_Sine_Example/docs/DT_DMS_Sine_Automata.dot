// The two automata of the DT-DMS sine example, as state diagrams (black and white).
// Solid arrow: external transition (triggered by an input, written ?).
// Dashed arrow: internal transition (triggered when the Delay of the phase has elapsed; outputs are written !).
// All positions are fixed (inches), so render with neato, not dot (from the docs folder):
//   neato -Tpdf DT_DMS_Sine_Automata.dot -o DT_DMS_Sine_Automata.pdf
//   neato -Tpng -Gdpi=300 DT_DMS_Sine_Automata.dot -o DT_DMS_Sine_Automata.png
digraph DT_DMS_Sine_Automata {
  graph [splines=line, fontname="Arial", fontsize=13, margin=0.05, bgcolor=white];
  node  [shape=box, style="rounded,filled", fillcolor=white, color=black, fontname="Arial", fontsize=13, fixedsize=true, width=1.7, height=0.75];
  edge  [fontname="Cambria Math", fontsize=12, arrowsize=0.9, color=black];

  // ---------------------------------------------------------------- the model
  subgraph cluster_model {
    label=<<b>Model  DT_Model_Descr_CubicBSpline</b><br/><font face="Cambria Math">ℳ = ⟨Λ, X, Y, Σ, Φ, Δ, Δ*⟩     Λ = {step, leftEndpoint}   X = {data}   Y = {updated}   Σ = {count, last}</font>>;
    labelloc=t; style="rounded"; color=gray55; penwidth=1.2;
    mo_a [pos="0.1,3.75!", shape=point, width=0.01, style=invis];
    mo_b [pos="10.7,6.9!", shape=point, width=0.01, style=invis];
    m0 [pos="0.6,5.0!", shape=point, width=0.12, fillcolor=black];
    WAIT   [pos="2.6,5.0!", label=<<b>WAIT</b><br/><font face="Cambria Math" point-size="12">Delay = ∞</font>>];
    UPDATE [pos="9.2,5.0!", label=<<b>UPDATE</b><br/><font face="Cambria Math" point-size="12">Delay = 0</font>>];
    m0 -> WAIT;
    WAIT -> UPDATE [tailport=ne, headport=nw];
    UPDATE -> WAIT [tailport=sw, headport=se, style=dashed];
  }

  // ---------------------------------------------------------------- the service
  subgraph cluster_service {
    label=<<b>Service  DT_Service_Diagnosis_Sine</b><br/><font face="Cambria Math">𝒮 = ⟨Λ, X, Y, Σ, Φ, Δ, Δ*⟩     Λ = {threshold}   X = {data}   Y = {anomaly}   Σ = {residual}</font>>;
    labelloc=t; style="rounded"; color=gray55; penwidth=1.2;
    se_a [pos="0.1,-0.35!", shape=point, width=0.01, style=invis];
    se_b [pos="10.7,3.2!", shape=point, width=0.01, style=invis];
    s0 [pos="0.6,1.4!", shape=point, width=0.12, fillcolor=black];
    IDLE  [pos="2.6,1.4!", label=<<b>IDLE</b><br/><font face="Cambria Math" point-size="12">Delay = ∞</font>>];
    CHECK [pos="9.2,1.4!", label=<<b>CHECK</b><br/><font face="Cambria Math" point-size="12">Delay = 0</font>>];
    s0 -> IDLE;
    IDLE -> CHECK [tailport=ne, headport=nw];
    CHECK -> IDLE [tailport=w, headport=e, style=dashed];
    CHECK -> IDLE [tailport=sw, headport=se, style=dashed];
  }

  // ---------------------------------------------------------------- labels of the transitions (placed by hand)
  node [shape=plaintext, style="", fixedsize=false, width=0, height=0, margin=0, fontname="Cambria Math", fontsize=12];
  l1 [pos="1.55,5.17!", label=<Δ*>];
  l2 [pos="5.9,5.7!",  label=<Δ<sup>in</sup> :   ? (data, d)   /   count := count + 1,  last := d>];
  l3 [pos="5.9,4.33!", label=<Δ<sup>time</sup> :   ! (updated, count)>];
  l4 [pos="1.55,1.57!", label=<Δ*>];
  l5 [pos="5.9,2.1!",  label=<Δ<sup>in</sup> :   ? (data, d)   /   residual := |d − m(t)|>];
  l6 [pos="5.9,1.57!", label=<Δ<sup>time</sup> :   [residual &gt; threshold]   /   ! (anomaly, residual)>];
  l7 [pos="5.9,0.73!", label=<Δ<sup>time</sup> :   [residual ≤ threshold]>];
}
