// Overview class diagram of the DT-DMS framework for the paper: class names and formal symbols only.
// Render (from the docs folder):
//   dot -Tpdf DT_DMS_Overview.dot -o DT_DMS_Overview.pdf
//   dot -Tpng -Gdpi=300 DT_DMS_Overview.dot -o DT_DMS_Overview.png
digraph DT_DMS_Overview {
  graph [rankdir=LR, fontname="Arial", nodesep=0.28, ranksep=1.1, margin=0.05, bgcolor=white, compound=true];
  node  [shape=box, style="filled", fillcolor=white, fontname="Arial", fontsize=13, margin="0.12,0.07", height=0.4];
  edge  [fontname="Arial", fontsize=11, arrowsize=0.9];

  // ---------------------------------------------------------------- general classes
  DT_DMS [fillcolor="#FFE0B2", penwidth=1.6, label=<<b>DT_DMS</b><br/><font face="Cambria Math" point-size="12">DT = ⟨D, M, S, μ⟩</font>>];
  DT_DMS_Architecture [fillcolor="#FFF3E0", label=<<b>DT_DMS_Architecture</b>>];

  // ---------------------------------------------------------------- Automaton
  subgraph cluster_automaton {
    label=<<b>Automaton</b>>; margin=16; fontname="Arial"; fontsize=12; style="rounded,filled"; fillcolor="#ECEFF1"; color="#607D8B";
    DT_Automaton [label=<<i>«abstract»</i><br/><b>DT_Automaton</b><br/><font face="Cambria Math" point-size="12">⟨Λ, X, Y, Σ, Φ, Δ, Δ*⟩</font>>];
  }

  // ---------------------------------------------------------------- Data
  subgraph cluster_data {
    label=<<b>Data</b>>; margin=16; fontname="Arial"; fontsize=12; style="rounded,filled"; fillcolor="#E3F2FD"; color="#1565C0";
    DT_Data [label=<<b>DT_Data</b><br/><font face="Cambria Math" point-size="12">D = D<sub>hist</sub> ∪ D<sub>rt</sub></font>>];
    DT_DataSegment [label=<<b>DT_DataSegment</b><br/><font face="Cambria Math" point-size="12">ω : T<sub>U</sub> ⇀ D</font>>];
  }

  // ---------------------------------------------------------------- Models
  subgraph cluster_models {
    label=<<b>Models</b>>; margin=16; fontname="Arial"; fontsize=12; style="rounded,filled"; fillcolor="#E8F5E9"; color="#2E7D32";
    DT_Model [label=<<i>«abstract»</i><br/><b>DT_Model</b><br/><font face="Cambria Math" point-size="12">m ∈ M</font>>];
    DT_Model_Descriptive  [label=<<b>DT_Model_Descriptive</b>  <font face="Cambria Math" point-size="12">(M<sub>desc</sub>)</font>>];
    DT_Model_Predictive   [label=<<b>DT_Model_Predictive</b>  <font face="Cambria Math" point-size="12">(M<sub>pred</sub>)</font>>];
    DT_Model_Prescriptive [label=<<b>DT_Model_Prescriptive</b>  <font face="Cambria Math" point-size="12">(M<sub>presc</sub>)</font>>];
  }

  // ---------------------------------------------------------------- Services
  subgraph cluster_services {
    label=<<b>Services</b>>; margin=16; fontname="Arial"; fontsize=12; style="rounded,filled"; fillcolor="#FBE9E7"; color="#BF360C";
    DT_Service [label=<<i>«abstract»</i><br/><b>DT_Service</b><br/><font face="Cambria Math" point-size="12">s : M × Ω<sub>D</sub> → Y<sub>s</sub></font>>];
    DT_Service_Monitoring   [label=<<b>DT_Service_Monitoring</b>  <font face="Cambria Math" point-size="12">(S<sub>moni</sub>)</font>>];
    DT_Service_Prediction   [label=<<b>DT_Service_Prediction</b>  <font face="Cambria Math" point-size="12">(S<sub>pred</sub>)</font>>];
    DT_Service_Diagnosis    [label=<<b>DT_Service_Diagnosis</b>  <font face="Cambria Math" point-size="12">(S<sub>diag</sub>)</font>>];
    DT_Service_Optimization [label=<<b>DT_Service_Optimization</b>  <font face="Cambria Math" point-size="12">(S<sub>opti</sub>)</font>>];
    DT_Service_Control      [label=<<b>DT_Service_Control</b>  <font face="Cambria Math" point-size="12">(S<sub>cont</sub>)</font>>];
  }

  // ---------------------------------------------------------------- Mu
  subgraph cluster_mu {
    label=<<b>Mu</b>>; margin=16; fontname="Arial"; fontsize=12; style="rounded,filled"; fillcolor="#F3E5F5"; color="#6A1B9A";
    DT_Mu [label=<<b>DT_Mu</b><br/><font face="Cambria Math" point-size="12">μ : Ω<sub>D</sub> × M → M</font>>];
    ObserverData [label=<<i>«interface»</i><br/><b>ObserverData</b>>];
    ObserverDataManager [label=<<i>«interface»</i><br/><b>ObserverDataManager</b>>];
  }

  // ---------------------------------------------------------------- inheritance (hollow triangle at the parent)
  edge [dir=back, arrowtail=onormal, style=solid, color="#333333"];
  DT_DMS -> DT_DMS_Architecture [constraint=false];
  DT_Automaton -> DT_Model;
  DT_Automaton -> DT_Service;
  DT_Model -> DT_Model_Descriptive;
  DT_Model -> DT_Model_Predictive;
  DT_Model -> DT_Model_Prescriptive;
  DT_Service -> DT_Service_Monitoring;
  DT_Service -> DT_Service_Prediction;
  DT_Service -> DT_Service_Diagnosis;
  DT_Service -> DT_Service_Optimization;
  DT_Service -> DT_Service_Control;

  // ---------------------------------------------------------------- implements (dashed, hollow triangle at the interface)
  edge [dir=back, arrowtail=onormal, style=dashed, color="#6A1B9A"];
  ObserverData -> DT_Model;
  ObserverData -> DT_Service;
  ObserverDataManager -> DT_Data;

  // ---------------------------------------------------------------- composition (filled diamond at the whole)
  edge [dir=back, arrowtail=diamond, style=solid, color="#E65100", fontcolor="#E65100"];
  DT_DMS -> DT_Data    [label=" D  0..*"];
  DT_DMS -> DT_Model   [label=" M  0..*"];
  DT_DMS -> DT_Service [label=" S  0..*"];
  DT_DMS -> DT_Mu      [label=" μ  1"];
  DT_Data -> DT_DataSegment [label=" 1", color="#1565C0", fontcolor="#1565C0"];

  // ---------------------------------------------------------------- associations
  edge [dir=forward, arrowhead=vee, arrowtail=none, style=solid, color="#555555", fontcolor="#333333"];
  DT_Service -> DT_Model [label="coupled model  0..1", constraint=false];
  DT_Mu -> DT_Data       [label="observes", constraint=false];
  DT_Mu -> DT_Model      [label=<updates: μ(ω, m) = m′>, constraint=false];

  // keep the general classes together on the left
  { rank=same; DT_DMS; DT_DMS_Architecture; }
}
